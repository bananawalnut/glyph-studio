            "component",
            "connection",
            "contract",
            "obstacle",
            "flow"
          ]
        },
        "id": {
          "type": "string"
        },
        "changes_json": {
          "type": "string",
          "maxLength": 100000
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Current target revision returned by its last read; flow jobs use their draft revision. Stale writes fail."
        }
      },
      "required": [
        "action",
        "kind",
        "expected_revision"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "glyph_flow_invoke",
    "description": "Stage a typed method invocation such as source.add(record). It is queued on proposal commit and animated by an open flow browser. Do not claim delivery until a browser receipt says arrived.",
