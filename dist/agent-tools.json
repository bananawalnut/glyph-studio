[
  {
    "name": "glyph_flow_read",
    "description": "Read the functional flow document, revision, typed method interfaces, registry and invocation receipts. In studio flow jobs this reads the staged draft.",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "glyph_flow_validate",
    "description": "Read-only validation of current flow or candidate flow_json, including current states and contracts. No pixels or formal proof.",
    "parameters": {
      "type": "object",
      "properties": {
        "flow_json": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "glyph_flow_apply",
    "description": "Replace the flow with a complete validated data-only flow_json. Studio flow jobs stage this proposal; they commit once after completion if the starting revision is still current.",
    "parameters": {
      "type": "object",
      "properties": {
        "flow_json": {
          "type": "string",
          "maxLength": 100000
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Current target revision returned by its last read; flow jobs use their draft revision. Stale writes fail."
        }
      },
      "required": [
        "flow_json",
        "expected_revision"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "glyph_flow_edit",
    "description": "Add, merge-patch or remove a named component, connection, contract or obstacle. update flow changes root metadata/arrays. changes_json is JSON merge patch: null deletes keys, arrays replace. Studio edits are staged.",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "add",
            "update",
            "remove"
          ]
        },
        "kind": {
          "type": "string",
